# Copy to .env and edit. Never commit .env.

# Required: a long random secret used to sign login tokens (at least 32 characters).
#   macOS / Linux / Git Bash:  openssl rand -base64 48
#   Windows PowerShell:        [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Changing it later signs everyone out (nothing else is lost).
JWT_SIGNING_KEY=

# Port the app is served on.
WEB_PORT=8080

# true when the site is served over https (anywhere other than localhost). The sign-in cookie is then marked Secure.
AUTH_COOKIE_SECURE=false

# Set to false after you have created your own account to stop strangers registering on a public server.
ALLOW_REGISTRATION=true

# true creates demo@applytrail.dev (password: demo-password-123) with sample applications. For trying things out only.
SEED_DEMO_DATA=false
