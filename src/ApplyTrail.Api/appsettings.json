{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=applytrail.db"
  },
  "Jwt": {
    "Issuer": "applytrail",
    "Audience": "applytrail-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "AllowRegistration": true,
    "CookieSecure": true
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Seed": {
    "DemoData": false
  }
}
